# Copiar este archivo como .env y reemplazar los valores de ejemplo.
# El archivo .env esta en .gitignore: no subir credenciales reales al repositorio.

# PostgreSQL
POSTGRES_DB=electrocorp_db
POSTGRES_USER=electrocorp
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_PORT=5432

# Redis (cache del resumen de consumo, QA-02)
REDIS_PORT=6379
ENERGY_SUMMARY_CACHE_ENABLED=true

# Aplicacion
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Tarifa electrica en soles por kWh (TariffProvider, QA-06)
ENERGY_TARIFF_PER_KWH=0.75
